@using portfolio.main.Components
@inject IJSRuntime JSRuntime
@implements IDisposable

<!-- More Detail Navigation Item -->
<div class="more-detail-nav-item" @ref="navItemRef" @onmouseenter="OpenDropdown" @onmouseleave="StartCloseTimer">
    <div class="nav-link-modern more-detail-link">
        <div class="nav-icon">
            <i class="bi bi-person-circle"></i>
        </div>
        <span class="nav-text">More Detail</span>
        <i class="bi bi-chevron-right dropdown-arrow"></i>
    </div>

    <!-- Dropdown Menu - appears on right on hover -->
    <div class="more-detail-dropdown @(isDropdownOpen ? "show" : "")" style="@dropdownStyle" @onmouseenter="CancelCloseTimer" @onmouseleave="StartCloseTimer">
        <div class="dropdown-content">
            <button class="dropdown-item-custom" type="button" @onclick="ShowCvModal">
                <i class="bi bi-file-earmark-person me-2"></i>Get CV
            </button>
            <button class="dropdown-item-custom" type="button" @onclick="ShowCertsModal">
                <i class="bi bi-award me-2"></i>Get Certifications
            </button>
            <div class="dropdown-divider-custom"></div>
            <a class="dropdown-item-custom" href="@skillsoftWalletUrl" target="_blank">
                <i class="bi bi-award me-2"></i>Skillsoft Badges
                <i class="bi bi-box-arrow-up-right ms-auto small"></i>
            </a>
            <a class="dropdown-item-custom" href="@msLearnUrl" target="_blank">
                <i class="bi bi-mortarboard me-2"></i>MS Learn
                <i class="bi bi-box-arrow-up-right ms-auto small"></i>
            </a>
        </div>
    </div>
</div>

<!-- CV Modal -->
<Modal Show="@showCvModal" Title="Resume (PDF)" WidthCss="75vw" OnClose="CloseCvModal">
    <HeaderActions>
        @if (!string.IsNullOrWhiteSpace(activePdfPath))
        {
            <a class="btn btn-sm btn-outline-light" href="@activePdfPath" target="_blank" download>
                <i class="bi bi-download me-1"></i>Download
            </a>
        }
    </HeaderActions>
    <ChildContent>
        <object class="doc-viewer" data="@activePdfPath" type="application/pdf">
            <div class="p-3">
                <h6 class="mb-2">Unable to display PDF.</h6>
                <p class="mb-2">
                    @if (string.IsNullOrWhiteSpace(activePdfPath))
                    {
                        <span>No PDF path configured. Expected at <code>/assets/resume.pdf</code>.</span>
                    }
                    else
                    {
                        <span>Ensure the file exists at <code>@activePdfPath</code> under
                            <code>wwwroot</code>.</span>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(activePdfPath))
                {
                    <a class="btn btn-sm btn-primary" href="@activePdfPath" target="_blank">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Open in new tab
                    </a>
                }
            </div>
        </object>
    </ChildContent>
</Modal>

<!-- Certifications Modal -->
<Modal Show="@showCertsModal" Title="@CertsModalTitle" WidthCss="75vw" OnClose="CloseCertsModal">
    <HeaderActions>
        @if (viewingCert && selectedCert is not null)
        {
            @if (!string.IsNullOrWhiteSpace(selectedCert.PdfPath))
            {
                <a class="btn btn-sm btn-outline-light" href="@selectedCert.PdfPath" target="_blank" download>
                    <i class="bi bi-download me-1"></i>Download
                </a>
            }
            else
            {
                <!-- External site selector buttons -->
                <a class="btn btn-sm btn-outline-light" 
                   href="@msLearnUrl" 
                   target="_blank"
                   title="Opens in new tab">
                    <i class="bi bi-mortarboard me-1"></i>MS Learn
                    <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                </a>
                <button class="btn btn-sm @(externalSiteView == "skillsoft" ? "btn-primary" : "btn-outline-light")" 
                        @onclick="() => LoadSkillsoft()">
                    <i class="bi bi-award me-1"></i>Skillsoft
                </button>
            }
            <button class="btn btn-sm btn-outline-light" @onclick="BackToCertsGrid">
                <i class="bi bi-arrow-left me-1"></i>Back
            </button>
        }
    </HeaderActions>
    <ChildContent>
        @if (!viewingCert)
        {
            <div class="cert-grid">
                @foreach (CertificationItem c in certs)
                {
                    <div class="cert-card" @onclick="() => SelectCert(c)">
                        <img class="cert-thumb" src="@c.ThumbPath" alt="@c.Title" />
                        <div class="cert-caption">@c.Title</div>
                    </div>
                }
            </div>
        }
        else if (selectedCert is not null)
        {
            @if (string.IsNullOrWhiteSpace(selectedCert.PdfPath))
            {
                <iframe class="doc-viewer" src="@currentExternalUrl"></iframe>
            }
            else
            {
                <object class="doc-viewer" data="@selectedCert.PdfPath" type="application/pdf">
                    <iframe class="doc-viewer" src="@currentExternalUrl"></iframe>
                </object>
            }
        }
    </ChildContent>
</Modal>


@code {
    private ElementReference navItemRef;
    private string dropdownStyle = "";
    private bool isDropdownOpen = false;
    private bool showCvModal = false;
    private bool showCertsModal = false;
    private bool viewingCert = false;
    private string? activePdfPath;
    private readonly string cvPath = "/assets/resume.pdf";

    private List<CertificationItem> certs = new()
    {
        new("AZ-900: Microsoft Azure Fundamentals", "/assets/certs/az-900-thumb.png", "/assets/certs/az-900.pdf"),
        new("AZ-204: Microsoft Certified: Azure Developer Associate", "/assets/certs/az-204-thumb.png", ""),
        new("C-Sharp .NET: Fullstack .NET Bootcamp", "/assets/certs/c-shart.net-core.png", "/assets/certs/c-shart.net-core.pdf"),
    };

    private CertificationItem? selectedCert;
    private string CertsModalTitle => viewingCert && selectedCert is not null ? selectedCert.Title : "Certifications";
    private readonly string skillsoftWalletUrl =
    "https://skillsoft.digitalbadges.skillsoft.com/profile/fredneljeanjoseph168496/wallet";
    private readonly string msLearnUrl = "https://learn.microsoft.com/en-us/users/mrjeanjoseph/";
    private string externalSiteView = "skillsoft"; // Default to Skillsoft
    private string currentExternalUrl = "";

    private System.Threading.Timer? closeTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CalculateDropdownPosition();

            // Add resize listener to recalculate position on window resize
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.addEventListener('resize', () => {
                    const event = new CustomEvent('recalculateDropdown');
                    window.dispatchEvent(event);
                });
            ");
        }
    }

    private async Task CalculateDropdownPosition()
    {
        try
        {
            var rect = await JSRuntime.InvokeAsync<dynamic>("eval", 
                "document.querySelector('.more-detail-nav-item').getBoundingClientRect()");

            if (rect != null)
            {
                double top = rect.top;
                double bottom = rect.bottom;
                double windowHeight = await JSRuntime.InvokeAsync<double>("eval", "window.innerHeight");
                double dropdownHeight = 300; // Estimated dropdown height

                // Check if dropdown would overflow below viewport
                if (bottom + dropdownHeight > windowHeight)
                {
                    // Position dropdown to end at the bottom of viewport with some margin
                    double adjustedTop = Math.Max(10, windowHeight - dropdownHeight - 20);
                    dropdownStyle = $"top: {adjustedTop}px;";
                }
                else
                {
                    // Normal positioning aligned with the menu item
                    dropdownStyle = $"top: {top}px;";
                }

                StateHasChanged();
            }
        }
        catch
        {
            // Fallback - keep default positioning
        }
    }

    private async void OpenDropdown()
    {
        CancelCloseTimer();
        isDropdownOpen = true;

        // Recalculate position when opening to ensure proper placement
        await CalculateDropdownPosition();
    }

    private void StartCloseTimer()
    {
        closeTimer?.Dispose();
        closeTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                isDropdownOpen = false;
                StateHasChanged();
            });
        }, null, 200, System.Threading.Timeout.Infinite);
    }

    private void CancelCloseTimer()
    {
        closeTimer?.Dispose();
        closeTimer = null;
    }

    private void CloseDropdown()
    {
        CancelCloseTimer();
        isDropdownOpen = false;
    }

    public void Dispose()
    {
        closeTimer?.Dispose();
    }

    private void CloseAllModals()
    {
        showCvModal = false;
        showCertsModal = false;
        viewingCert = false;
        selectedCert = null;
        activePdfPath = null;
        externalSiteView = "skillsoft"; // Reset to default
        currentExternalUrl = "";
    }

    private void ShowCvModal()
    {
        // Close any open modals first
        CloseAllModals();

        // Close the dropdown
        CloseDropdown();

        // Open CV modal
        activePdfPath = cvPath;
        showCvModal = true;
        StateHasChanged();
    }

    private void CloseCvModal()
    {
        showCvModal = false;
        activePdfPath = null;
        StateHasChanged();
    }

    private void ShowCertsModal()
    {
        // Close any open modals first
        CloseAllModals();

        // Close the dropdown
        CloseDropdown();

        // Open Certifications modal
        showCertsModal = true;
        viewingCert = false;
        selectedCert = null;
        StateHasChanged();
    }

    private void CloseCertsModal()
    {
        showCertsModal = false;
        viewingCert = false;
        selectedCert = null;
        StateHasChanged();
    }

    private void SelectCert(CertificationItem item)
    {
        selectedCert = item;
        viewingCert = true;

        // Set default external URL to Skillsoft when selecting a cert without PDF
        if (string.IsNullOrWhiteSpace(item.PdfPath))
        {
            externalSiteView = "skillsoft";
            currentExternalUrl = skillsoftWalletUrl;
        }

        StateHasChanged();
    }

    private void LoadSkillsoft()
    {
        externalSiteView = "skillsoft";
        currentExternalUrl = skillsoftWalletUrl;
        StateHasChanged();
    }

    private void BackToCertsGrid()
    {
        viewingCert = false;
        selectedCert = null;
        externalSiteView = "skillsoft"; // Reset to default
        currentExternalUrl = "";
        StateHasChanged();
    }

    private record CertificationItem(string Title, string ThumbPath, string PdfPath);
}
